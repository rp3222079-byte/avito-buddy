AI_BASE_URL=http://ai-service:8000
VITE_API_MODE=mock
FRONTEND_PORT=5173
INTERNAL_TOKEN=replace-with-a-long-random-value
CORS_ALLOWED_ORIGINS=http://localhost:5173
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_SCORE_THRESHOLD=0.72
REQUEST_CONTEXT_SECRET=replace-with-a-long-random-value
DEMO_MODE=true
PENDING_ACTION_TTL=10m
LLM_BASE_URL=http://host.docker.internal:11434/v1/
# For a remote OpenAI-compatible API, set all three LLM fields.
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
